# ElevenLabs API key (Profile → API keys) for scripts.run_evals. Needs Agents read/write.
# The elevenlabs CLI logs in separately with `elevenlabs auth login`.
ELEVENLABS_API_KEY=

# Bearer token the backend expects in `Authorization: Bearer <token>`. The agent sends the
# `tool_secret` workspace environment variable as that whole header, so it must hold "Bearer <token>".
TOOL_SECRET=change-me

# Local MySQL started by `docker compose up -d` (compose.yaml). Use the same password in both URLs.
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
DATABASE_URL=mysql+pymysql://bank:change-me@127.0.0.1:3307/bank?charset=utf8mb4
# Disposable database for pytest; its tables are emptied before every test.
TEST_DATABASE_URL=mysql+pymysql://bank:change-me@127.0.0.1:3307/bank_test?charset=utf8mb4
